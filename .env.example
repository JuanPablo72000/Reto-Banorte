# Copia este archivo como .env antes de iniciar Docker Compose.
# No guardes claves reales ni secretos en el repositorio.

# Backend
# Sustituye este valor por un secreto aleatorio de al menos 32 caracteres.
JWT_KEY=cambia-este-secreto-por-uno-seguro-de-32-caracteres
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__Default=Data Source=/data/app.db

# Direcciones públicas usadas desde el navegador y las herramientas locales.
# Incluye siempre http:// o https://.
NEXT_PUBLIC_API_URL=http://localhost:8000
BANORTE_API_BASE_URL=http://localhost:8000
BANORTE_API_TIMEOUT=10

# Credenciales del usuario demo que usa el MCP cuando no recibe otro token.
BANORTE_API_EMAIL=demo@banorte.mx
BANORTE_API_PASSWORD=Demo123!
BANORTE_API_MODE=auto

# Proveedor principal de IA. Deja la clave vacía si usarás solamente Gemini.
DEEPSEEK_API_KEY=
DEEPSEEK_MODELS=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Proveedor alternativo. Deja la clave vacía si usarás solamente DeepSeek.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.8-flash

# Límites del cliente de IA.
IA_MAX_RETRIES=2
IA_MAX_COMPLETION_TOKENS=8192

# Servidor MCP. Docker Compose sobrescribe la dirección interna de la API.
MCP_TRANSPORT=http
MCP_PORT=8080

# Ejemplo para conectar el frontend y el MCP a una API desplegada:
# NEXT_PUBLIC_API_URL=https://api-production-4662.up.railway.app
# BANORTE_API_BASE_URL=https://api-production-4662.up.railway.app
