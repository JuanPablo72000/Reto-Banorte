# --- Groq (ia/groq_client.py) ---
GROQ_API_KEY=tu_api_key_de_groq
GROQ_MODELS_FAST=qwen/qwen3.8-27b,qwen/qwen3.6-27b
GROQ_MODELS_BALANCED=openai/gpt-oss-20b,openai/gpt-oss-safeguard-20b
GROQ_MODELS_STRONG=openai/gpt-oss-120b
GROQ_MAX_RETRIES=2
GROQ_MAX_COMPLETION_TOKENS=8192

# --- Gemini (ia/groq_client.py) — último recurso, proveedor distinto ---
# Opcional: si se deja vacío, no se usa (el comportamiento queda igual
# que antes, solo con los tiers de Groq). Se prueba SOLO después de
# agotar los 3 tiers de Groq (fast/balanced/strong), para no depender de
# un único proveedor cuando Groq da 429 en todos sus modelos.
GEMINI_API_KEY=tu_api_key_de_gemini
GEMINI_MODELS=gemini-2.5-flash

# --- Integración con la API real de Pablo (integration/api_client.py) ---
# El contrato A2UI (contracts/a2ui/a2ui-mcp-contract.yaml) declara
# http://localhost:8000, pero el backend .NET, tal como está configurado
# hoy (Properties/launchSettings.json), corre en el puerto 5178.
BANORTE_API_BASE_URL=http://localhost:5178
BANORTE_API_TIMEOUT=10

# --- Catálogo del contrato A2UI (ia/contract_catalog.py) ---
# Opcional: solo si el YAML no está en la ruta por defecto
# (contracts/a2ui/a2ui-mcp-contract.yaml, relativo a la raíz del repo).
# A2UI_CONTRACT_PATH=contracts/a2ui/a2ui-mcp-contract.yaml
